# Настройки sendmail-шима. Скопируйте в /etc/mailer-sendmail.conf.
#
# В файле лежит ключ проекта — это доступ к отправке почты от вашего имени:
#   chown root:www-data /etc/mailer-sendmail.conf
#   chmod 640 /etc/mailer-sendmail.conf
#
# Файл читают оба варианта шима: и shell, и PHP. Синтаксис общий — KEY=value,
# без пробелов вокруг «=», комментарии с решётки. Любую настройку можно
# переопределить переменной окружения, а сам путь к файлу — через MAILER_CONF.

# Адрес сервиса без /api/v1 на конце
MAILER_URL=https://mail.example.ru

# Ключ проекта: php bin/mailer key:create имя-сервера
MAILER_KEY=

# Сколько секунд ждать ответа сервиса, дальше — временная ошибка (код 75)
MAILER_TIMEOUT=15

# Метка для писем этого сервера — по ней их удобно фильтровать в панели
MAILER_TAG=

# Файл, куда писать, что ушло и что не ушло. Пусто — не писать.
# Каталог должен быть доступен на запись тому пользователю, от кого работает шим
MAILER_LOG=
