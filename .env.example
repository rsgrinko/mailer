# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не попадает — в нём лежат пароли.

APP_NAME=Mailer
APP_ENV=production
APP_DEBUG=false
# Ключ шифрования паролей SMTP в базе. Сгенерировать: php bin/mailer app:key
APP_KEY=
APP_TIMEZONE=Europe/Moscow
# Домен для заголовка Message-ID (лучше указать реальный домен отправителя)
APP_HOSTNAME=localhost

# --- База данных ---------------------------------------------------------
# sqlite (по умолчанию) или mysql
DB_DRIVER=sqlite
DB_SQLITE_PATH=

# Заполняется, когда переключаетесь на MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mailer
DB_USERNAME=mailer
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Логи ----------------------------------------------------------------
LOG_LEVEL=info
# Писать в лог весь диалог с SMTP-сервером (только для отладки)
LOG_SMTP=false
LOG_KEEP_DAYS=30

# --- Очередь -------------------------------------------------------------
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH=20
QUEUE_SLEEP=5
QUEUE_STUCK_AFTER=900
QUEUE_KEEP_SENT_DAYS=30

# --- Ограничения ---------------------------------------------------------
MAX_RECIPIENTS=50
MAX_ATTACHMENT_SIZE=10485760
MAX_MESSAGE_SIZE=26214400

# --- SMTP-клиент ---------------------------------------------------------
SMTP_TIMEOUT=30
SMTP_VERIFY_PEER=true
SMTP_LOCAL_DOMAIN=

# --- Локальный SMTP-релей (для приложений без SDK) -----------------------
SMTPD_HOST=127.0.0.1
SMTPD_PORT=2525
SMTPD_HOSTNAME=mailer.local
SMTPD_PROJECT=local-relay
# Если заполнить — релей потребует авторизацию
SMTPD_AUTH_USER=
SMTPD_AUTH_PASSWORD=

# --- sendmail-shim -------------------------------------------------------
SENDMAIL_PROJECT=local-sendmail

# --- Вебхуки -------------------------------------------------------------
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_ATTEMPTS=5

# --- Веб-панель ----------------------------------------------------------
UI_PER_PAGE=30
UI_ALLOW_ACTIONS=true
# Вход в панель по логину и паролю. Пользователи заводятся командой
# php bin/mailer user:create <логин> или на странице первого запуска.
# false — панель открыта всем, кто до неё дотянулся (только если её закрывает nginx)
UI_AUTH=true
# Сколько секунд бездействия до повторного запроса пароля (0 — не спрашивать)
UI_SESSION_LIFETIME=43200

# --- Данные для первичного заполнения (php bin/mailer seed) --------------
# SMTP-аккаунт, который станет транспортом по умолчанию
SEED_SMTP_HOST=smtp.yandex.ru
SEED_SMTP_PORT=465
SEED_SMTP_ENCRYPTION=ssl
SEED_SMTP_USERNAME=
SEED_SMTP_PASSWORD=
SEED_SMTP_FROM_EMAIL=
SEED_SMTP_FROM_NAME=
# Куда слать тестовые письма командой php bin/mailer send:test
SEED_TEST_EMAIL=
