# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не попадает — в нём лежат пароли.

APP_NAME=Mailer
APP_ENV=production
APP_DEBUG=false
# Ключ шифрования паролей SMTP в базе. Сгенерировать: php bin/mailer app:key
APP_KEY=
APP_TIMEZONE=Europe/Moscow
# Домен для заголовка Message-ID (лучше указать реальный домен отправителя)
APP_HOSTNAME=localhost
# Внешний адрес сервиса — из него собирается ссылка отписки в письмах
APP_URL=https://mail.internal

# --- База данных ---------------------------------------------------------
# sqlite (по умолчанию) или mysql
DB_DRIVER=sqlite
DB_SQLITE_PATH=

# Заполняется, когда переключаетесь на MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mailer
DB_USERNAME=mailer
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Тесты (php bin/mailer test) эти настройки не читают вовсе: они работают на своей
# SQLite в памяти. Иначе прогон уносил бы данные боевой базы — тесты сносят
# пользователей панели и разгребают очередь до дна.

# --- Логи ----------------------------------------------------------------
LOG_LEVEL=info
# Писать в лог весь диалог с SMTP-сервером (только для отладки)
LOG_SMTP=false
LOG_KEEP_DAYS=30

# --- Очередь -------------------------------------------------------------
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH=20
QUEUE_SLEEP=5
QUEUE_STUCK_AFTER=900
QUEUE_KEEP_SENT_DAYS=30

# --- Ограничения ---------------------------------------------------------
MAX_RECIPIENTS=50
MAX_ATTACHMENT_SIZE=10485760
MAX_MESSAGE_SIZE=26214400

# --- SMTP-клиент ---------------------------------------------------------
SMTP_TIMEOUT=30
SMTP_VERIFY_PEER=true
SMTP_LOCAL_DOMAIN=
# Не рвать соединение между письмами и сколько писем слать в одной сессии
SMTP_KEEPALIVE=true
SMTP_SESSION_LIMIT=100

# --- Локальный SMTP-релей (для приложений без SDK) -----------------------
SMTPD_HOST=127.0.0.1
SMTPD_PORT=2525
SMTPD_HOSTNAME=mailer.local
# Предел размера письма, которое примет релей, байт
SMTPD_MAX_SIZE=26214400
SMTPD_PROJECT=local-relay
# Если заполнить — релей потребует авторизацию
SMTPD_AUTH_USER=
SMTPD_AUTH_PASSWORD=

# --- sendmail-shim -------------------------------------------------------
SENDMAIL_PROJECT=local-sendmail

# --- Вебхуки -------------------------------------------------------------
# Адреса и события задаются в панели: Вебхуки -> Вебхуки проектов
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_ATTEMPTS=5
# Сколько дней хранить разобранные доставки вместе с ответами серверов (0 — всегда)
WEBHOOK_KEEP_DAYS=30

# --- Отписка одной кнопкой (List-Unsubscribe) ----------------------------
# Gmail и Mail.ru требуют её от массовых рассылок. Нужен внешний адрес сервиса
UNSUBSCRIBE_ENABLED=false

# --- Ящик отказов (недоставленные письма) --------------------------------
# Сборщик читает этот ящик по POP3 и закрывает адреса, по которым пришёл отказ
BOUNCE_ENABLED=false
BOUNCE_HOST=
BOUNCE_PORT=995
BOUNCE_ENCRYPTION=ssl
BOUNCE_USERNAME=
BOUNCE_PASSWORD=
BOUNCE_DELETE=true
BOUNCE_LIMIT=50
BOUNCE_INTERVAL=300
# Обратный адрес писем. С BOUNCE_VERP=true письмо уходит с адресом bounce+<uuid>@домен,
# и отказ сразу привязывается к письму. Работает на своём сервере: Яндекс такой конверт
# не примет — он шлёт только от адреса аккаунта
BOUNCE_ADDRESS=
BOUNCE_VERP=false

# --- Стоп-лист адресов ---------------------------------------------------
# Закрывать адрес самим, когда сервер получателя ответил «нет такого ящика»
SUPPRESSION_AUTO_BOUNCE=true

# --- Метрики для Prometheus ---------------------------------------------
METRICS_ENABLED=true
# Пустой токен — /metrics открыт всем, кто до него дотянулся
METRICS_TOKEN=

# --- Веб-панель ----------------------------------------------------------
UI_PER_PAGE=30
UI_STATS_CACHE=30
UI_ALLOW_ACTIONS=true
# Вход в панель по логину и паролю. Пользователи заводятся командой
# php bin/mailer user:create <логин> или на странице первого запуска.
# false — панель открыта всем, кто до неё дотянулся (только если её закрывает nginx)
UI_AUTH=true
# Сколько секунд бездействия до повторного запроса пароля (0 — не спрашивать)
UI_SESSION_LIFETIME=43200
# На сколько дней запоминает галка «запомнить меня» на входе (0 — галки нет)
UI_REMEMBER_DAYS=30
# Сколько дней хранить журнал действий панели (0 — хранить всегда)
UI_AUDIT_KEEP_DAYS=180

# --- Данные для первичного заполнения (php bin/mailer seed) --------------
# SMTP-аккаунт, который станет транспортом по умолчанию
# Под каким именем транспорт появится в панели
SEED_SMTP_NAME=yandex
SEED_SMTP_HOST=smtp.yandex.ru
SEED_SMTP_PORT=465
SEED_SMTP_ENCRYPTION=ssl
SEED_SMTP_USERNAME=
SEED_SMTP_PASSWORD=
SEED_SMTP_FROM_EMAIL=
SEED_SMTP_FROM_NAME=
# Куда слать тестовые письма командой php bin/mailer send:test
SEED_TEST_EMAIL=
